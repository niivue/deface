{
  "name": "deface",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "BSD-2-Clause",
  "description": "Remove facial features from brain MRI for anonymization, entirely in the browser. No data leaves your machine. Uses niimath (BSD affine defacing, fast engine) + NiiVue.",
  "scripts": {
    "dev": "node scripts/copy-brainchop.mjs && vite",
    "build": "node scripts/copy-brainchop.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "@brainchop/mindgrab": "file:../brainchopC/js/brainchop-mindgrab-0.1.20260813.tgz",
    "@niivue/dcm2niix": "^1.2.0",
    "@niivue/niimath": "1.3.3",
    "@niivue/niivue": "1.0.0-rc.9"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.52",
    "playwright": "^1.57.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
